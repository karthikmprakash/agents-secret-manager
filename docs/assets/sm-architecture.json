  "cards": [
    {
      "dot": "cyan",
      "title": "Runtime",
      "items": [
        "MCP over stdio; no value-returning tool",
        "Selected names or a service are injected into the child",
        "Captured output is bounded and exact sensitive values are redacted"
      ]
    },
    {
      "dot": "emerald",
      "title": "Storage",
      "items": [
        "One age X25519 vault; the identity stays in the Keychain",
        "Global and project manifests carry references only",
        "Audit records names, not values"
      ]
    },
    {
      "dot": "rose",
      "title": "Boundary",
      "items": [
